{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-action-studio-website",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-03-01",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "workers_dev": true,
  "routes": [
    { "pattern": "aiactionstudio.com", "custom_domain": true },
    { "pattern": "www.aiactionstudio.com", "custom_domain": true },
    { "pattern": "aiwealthbase.com", "custom_domain": true },
    { "pattern": "www.aiwealthbase.com", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  }
}
